# --- Telegram ---
BOT_TOKEN=123456:ABC-token-de-BotFather
# Solo para webhook (Render). Letras, números, _ y -. Genera uno largo y aleatorio.
WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo
# Render define RENDER_EXTERNAL_URL solo; en otro host pon tu URL pública https.
# WEBHOOK_BASE_URL=https://mi-bot.onrender.com
# IDs de Telegram autorizados, separados por comas (escribe al bot para ver el tuyo).
ALLOWED_USER_IDS=111111111

# --- Google Drive (cliente OAuth de tipo "Aplicación web") ---
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
# URL registrada en Google Cloud. En Render se calcula sola con RENDER_EXTERNAL_URL.
# GOOGLE_REDIRECT_URI=https://mi-bot.onrender.com/oauth/callback

# El refresh token NO hace falta en el entorno: /conectar lo obtiene desde el
# navegador y lo guarda cifrado en un mensaje fijado de Telegram.
# GOOGLE_REFRESH_TOKEN=opcional-solo-como-respaldo

# --- Opcionales ---
DRIVE_FOLDER_NAME=BridgeBot
MAX_FILE_MB=2048
TTL_HOURS=6
CHUNK_SIZE_MB=8
# Ruta del archivo local donde se guarda el token (por defecto .state/google-token.json).
# TOKEN_STORE_PATH=/var/data/google-token.json
# Chat donde se fija el token cifrado si ALLOWED_USER_IDS tiene varios IDs.
# OAUTH_STORE_CHAT_ID=111111111

# --- MediaFire ---
# Render usa IPs de datacenter y MediaFire puede bloquearlas con Cloudflare.
# Si ocurre, configura un proxy HTTP/HTTPS con IP residencial (solo afecta a MediaFire).
# MEDIAFIRE_PROXY_URL=http://usuario:clave@proxy.ejemplo.com:8080
