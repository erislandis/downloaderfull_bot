# Copia este archivo a ".env" (mismo directorio que run.py) y rellena tus datos.
# El .env NO se sube a GitHub (está en .gitignore).

# Obligatorias
BOT_TOKEN=pon_aqui_el_token_de_BotFather
TELEGRAM_API_ID=pon_aqui_tu_api_id
TELEGRAM_API_HASH=pon_aqui_tu_api_hash
TELEGRAM_SESSION=pon_aqui_tu_string_session

# ID(s) de Telegram de los administradores, separados por comas.
# Solo ellos pueden usar los comandos de administración (/admin, /cola, /broadcast...).
# El bot lo puede usar cualquiera; ADMIN_USER_IDS solo controla la administración.
ADMIN_USER_IDS=
# Nombre antiguo, todavía se lee si ADMIN_USER_IDS está vacío:
# ALLOWED_USER_IDS=

# Webhook (solo Render; en local se ignora)
# WEBHOOK_BASE_URL=https://tu-servicio.onrender.com
# WEBHOOK_SECRET=cadena-aleatoria-larga

# Opcionales (valores por defecto)
BOT_API_MAX_MB=50
MAX_FILE_MB=2048
BUFFER_MB=16
TTL_HOURS=6
# Trozos de 512 KB en paralelo al subir por MTProto (1-8; más = más rápido con latencia alta).
MT_UPLOAD_PARALLEL=6
# Nivel de compresión de los ZIP (0 = sin comprimir, 9 = máximo). En Render, 1 es lo más rentable.
ZIP_LEVEL=1

# Reinicio (solo Render): Deploy Hook del servicio. Si está vacío, /reiniciar termina el proceso.
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-...?key=...
